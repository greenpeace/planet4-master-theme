{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "planet4-blocks/social-media",
  "category": "planet4-blocks",
  "description": "An embed-style block, customized to display and align content from Facebook and Instagram by inputting the URL.",
  "title": "Meta",
  "icon": "share",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "embed_type": {
      "type": "string",
      "default": ""
    },
    "facebook_page_tab": {
      "type": "string",
      "default": "timeline"
    },
    "social_media_url": {
      "type": "string",
      "default": ""
    },
    "alignment_class": {
      "type": "string",
      "default": ""
    },
    "embed_code": {
      "type": "string",
      "default": ""
    }
  },
  "viewScript": ["file:view-script.js", "instagram-embed"],
  "editorScript": ["file:index.js", "instagram-embed"],
  "style": "file:index.css"
}
