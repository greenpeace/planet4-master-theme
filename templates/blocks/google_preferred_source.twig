<a
    aria-label="{{ __( 'Add as a preferred source on Google', 'planet4-master-theme' ) }}"
    class="google-preferred-source-link"
    href="https://google.com/preferences/source?q={{ google_preferred_source.domain }}"
    target="_blank"
    data-ga-category="Button Click"
    data-ga-action="Preferred Source"
    data-ga-label="n/a"
>
    <img src="{{ google_preferred_source.image }}" alt="Google preferred source" />
    <span>{{ __( 'Add as a preferred source on Google', 'planet4-master-theme' ) }}</span>
</a>
